

config {
    type: "operations",
    schema: dataform.projectConfig.vars.QUALITY_DATASET,
    hasOutput: true // optional, lets you reference the empty table
}

BEGIN
  DECLARE full_table_path STRING;

  -- The dataset is provisioned during installation; runtime only needs table permissions.
  SET full_table_path = "${self()}";
  -- Create the table if it doesn't exist
  EXECUTE IMMEDIATE FORMAT(
    '''
    CREATE TABLE IF NOT EXISTS
      %s (
        inserted_at TIMESTAMP,
        assertion STRING,
        model STRING,
        expectations INT64,
        count INT64,
        sample STRING,
        assertion_status STRING,
        error_msg STRING
      )
    ''', full_table_path);

END;

